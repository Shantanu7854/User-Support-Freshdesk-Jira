# ---------------------------------------------------------------------------
# Copy to .env and fill in. EVERY value except the datasource is optional -
# anything left blank degrades to a fallback rather than failing at startup.
# ---------------------------------------------------------------------------

# --- Supabase (required) ---------------------------------------------------
# Project Settings -> Database -> Connection string -> "Session pooler".
# Port 5432, NOT 6543. The direct db.<ref>.supabase.co host is IPv6-only and
# will not connect from most machines or from Render.
SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres.<your-project-ref>
SPRING_DATASOURCE_PASSWORD=<your-db-password>

# Same database, in libpq URL form, for the MCP server (Node).
MCP_DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- LLM providers (both free, no credit card) -----------------------------
# Primary: aistudio.google.com -> Get API key
GEMINI_API_KEY=
# Fallback: console.groq.com -> API Keys
GROQ_API_KEY=

# --- Freshdesk (blank => simulated tickets) --------------------------------
# Trial only: the permanent free plan has ZERO API access.
FRESHDESK_DOMAIN=
FRESHDESK_API_KEY=

# --- Jira Cloud (blank => simulated issues) --------------------------------
# Free tier is permanent. Token: id.atlassian.com -> Security -> API tokens
JIRA_BASE_URL=https://<your-site>.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=SUP
# From GET /rest/api/3/myself - accountId only, usernames were removed post-GDPR
JIRA_ACCOUNT_ID=

# --- MCP -------------------------------------------------------------------
# false => diagnostics run via direct JDBC instead of the MCP wire
MCP_ENABLED=true
